# Apache configuration for Magaverse static site (Aruba hosting compatible)
# Place this file in the same folder as the deployed site (httpdocs/)

# ---- 1. Enable URL rewriting ----
RewriteEngine On

# ---- 2. Clean URLs: serve /oceanbeach/about -> /oceanbeach/about.html ----
# If the request maps to an existing file or directory, serve it as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise, try to append .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---- 3. Force HTTPS (raccomandato dopo aver attivato SSL su Aruba) ----
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 4. Default index ----
DirectoryIndex index.html

# ---- 5. Custom error page (opzionale) ----
# ErrorDocument 404 /404.html

# ---- 6. Caching for static assets ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ---- 7. Gzip compression ----
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain text/xml application/xml application/json
</IfModule>

# ---- 8. Security headers (basic) ----
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
